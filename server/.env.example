# Server Port (Render sets this automatically)
PORT=5000
NODE_ENV=development

# Allowed Frontend Origin for CORS (e.g. http://localhost:5173 or https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173

# Google Gemini API Key (Get free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Supabase Credentials (Get from https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://your-project-id.supabase.co
# Use Service Role Key for server-side admin access, or Anon key for user-level access
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_anon_key_here

# Brevo (Sendinblue) Transactional Email Service (Free 300 emails/day)
# Get free API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@email.com
BREVO_SENDER_NAME=ClearPath Security
